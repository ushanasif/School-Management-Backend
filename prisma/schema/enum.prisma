// amount is always positive; direction comes from the type
// balance = sum(INCOME + TRANSFER_IN) - sum(EXPENSE + TRANSFER_OUT)
enum FundTransactionType {
  INCOME
  EXPENSE
  TRANSFER_IN
  TRANSFER_OUT
}

enum FundTransactionSource {
  PAYMENT           // student fee payment (one row per allocation)
  PAYMENT_REVERSAL  // opposite row written when a payment is cancelled
  MANUAL_DEPOSIT    // money added to a fund by hand
  EXPENSE           // money spent from a fund
  TRANSFER          // fund to fund transfer (two rows sharing a transferId)
  ADJUSTMENT        // manual correction
}


// a student's religion, and the religion a religion subject is for
