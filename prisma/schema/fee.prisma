model FeeType {
  id String @id @default(cuid())

  schoolId String
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  fundId String
  fund Fund @relation(fields: [fundId], references: [id])

  name String
  description String?

  frequency FeeFrequency
  isActive Boolean @default(true)

  feeStructures FeeStructure[]
  studentFees StudentFee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([fundId])
}

model FeeStructure {
  id String @id @default(cuid())

  schoolId String
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  classId String
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  feeTypeId String
  feeType FeeType @relation(fields: [feeTypeId], references: [id])

  // base amount; for MONTHLY fees, monthlyAmounts overrides it month by month
  amount Decimal @db.Decimal(12, 2)

  monthlyAmounts FeeStructureMonth[]
  studentFees StudentFee[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, academicYearId, classId, feeTypeId])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([classId])
  @@index([feeTypeId])
}

model FeeStructureMonth {
  id String @id @default(cuid())

  feeStructureId String
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  month Int // 1-12
  amount Decimal @db.Decimal(10, 2)

  @@unique([feeStructureId, month])
  @@index([feeStructureId])
}

model StudentFee {
  id String @id @default(cuid())

  schoolId String
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentId String
  // Restrict: a student with fee history can be deactivated but not hard-deleted
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  academicYearId String
  // Restrict: an academic year with fees cannot be deleted
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  classId String?
  class SchoolClass? @relation(fields: [classId], references: [id])

  // null for custom fees that belong to one student only
  feeStructureId String?
  feeStructure FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)

  feeTypeId String
  feeType FeeType @relation(fields: [feeTypeId], references: [id])

  fundId String
  fund Fund @relation(fields: [fundId], references: [id])

  // payable = amount - discountAmount
  amount Decimal @db.Decimal(10, 2)

  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  discountReason String?
  discountedBy String?
  discountedAt DateTime?

  paidAmount Decimal @default(0) @db.Decimal(10, 2)

  month Int?
  year Int?

  status FeeStatus @default(UNPAID)
  dueDate DateTime?
  description String? // e.g. the reason for a fine

  allocations PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, feeStructureId, month, year])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([feeStructureId])
  @@index([fundId])
  @@index([status])
  @@index([schoolId, academicYearId, classId, status])
}

model Payment {
  id String @id @default(cuid())

  schoolId String
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentId String
  // Restrict: payment history must survive
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(10, 2)
  method PaymentMethod @default(CASH)
  status PaymentStatus @default(SUCCESS)
  transactionRef String?
  receivedBy String?
  paidAt DateTime @default(now())

  // a cancelled payment is kept and reversed, never deleted
  cancelledAt DateTime?
  cancelledBy String?
  cancelReason String?

  allocations PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

 
  @@index([schoolId])
  @@index([studentId])
  @@index([paidAt])
  @@index([schoolId, status, paidAt])
}

model PaymentAllocation {
  id String @id @default(cuid())

  paymentId String
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  studentFeeId String
  studentFee StudentFee @relation(fields: [studentFeeId], references: [id])

  amount Decimal @db.Decimal(10, 2)

  ledgerEntries FundTransaction[]

  createdAt DateTime @default(now())

  @@unique([paymentId, studentFeeId])
  @@index([paymentId])
  @@index([studentFeeId])
}

/*
 * Per-school counters (receipt numbers and similar).
 * key example: "receipt:2026"
 */
model SchoolSequence {
  id String @id @default(cuid())

  schoolId String
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  key String
  value Int @default(0)

  @@unique([schoolId, key])
  @@index([schoolId])
}